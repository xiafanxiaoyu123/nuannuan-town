# Ubuntu systemd EnvironmentFile=/etc/nuannuan/alipay-payment.env
# Root owned 0600; no secrets in the repository, browser, chat, logs or shell history.
# This adapter uses RSA2 PUBLIC-KEY mode, not Alipay certificate mode.
PAYMENT_PROVIDER=alipay_page
PAYMENT_CHECKOUT_ENABLED=0
PAYMENT_TEST_MODE=1
PAYMENT_TEST_USER_IDS=
PORTAL_COMMERCE_READY=0
ALIPAY_WAP_ENABLED=0

# Default is sandbox. Real payment requires an approved product/application,
# matching production credentials, ALIPAY_ENV=production and an explicit checkout switch.
# Do not replace sandbox credentials with production credentials while reusing orders.
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
# The merchant PID / seller user ID (16 digits, starting 2088), NOT a login/email.
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/srv/nuannuan/secrets/alipay_sandbox_app_private.pem
# Download the ALIPAY public key after uploading your APPLICATION public key.
# Never put the application public key in this file.
ALIPAY_PUBLIC_KEY_PATH=/srv/nuannuan/secrets/alipay_sandbox_public.pem
ALIPAY_NOTIFY_URL=https://example.invalid/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://example.invalid/membership.html

# Portals must accurately describe their own paid service and the actual fulfilment.
# Sandboxed orders never grant production membership / game entitlements.
PORTAL_MEMBER_PRICE_FEN=1
PORTAL_MEMBER_DAYS=30
PORTAL_MEMBER_SKU=portal_member_30d
PORTAL_MEMBER_NAME=门户网站会员
