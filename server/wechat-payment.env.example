# 仅供服务器 EnvironmentFile/受限进程环境参考，绝不要提交真实值。
PAYMENT_PROVIDER=wechat_native
WECHAT_TEST_MODE=1
# 仍统一免费且关闭购买；此示例不会授权开启真实支付。
PUBLIC_FREE_ENTITLEMENTS=1
PAYMENT_CHECKOUT_ENABLED=0
PORTAL_COMMERCE_READY=0

# 微信支付商户平台提供的商户号、绑定 AppID、商户 API 证书序列号
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_SERIAL_NO=

# 只设置其中一种：受限文件路径优先推荐；PEM 内容不要放进前端或仓库
WECHAT_PRIVATE_KEY_PATH=/srv/nuannuan/secrets/apiclient_key.pem
# WECHAT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----

# API v3 密钥是 32 字节字符串，用于回调解密
WECHAT_API_V3_KEY=

# 微信商户平台配置的支付回调地址，必须是公网 HTTPS
WECHAT_NOTIFY_URL=https://example.invalid/api/billing/wechat/notify

# 旧模式：微信支付平台证书，用于 API 应答及回调验签；发生轮换时要更新
WECHAT_PLATFORM_CERT_PATH=/srv/nuannuan/secrets/wechatpay.pem
# WECHAT_PLATFORM_SERIAL_NO=

# 当前商户若启用了“微信支付公钥”模式，填写公钥 PEM 和管理公钥页面显示的公钥 ID。
# 公钥 ID 通常形如 PUB_KEY_ID_3000000001；按应答/回调头 Wechatpay-Serial 选择。
# 平台证书或匹配 ID 的微信公钥至少配置一种；缺失时下单/查单均保持未就绪。
# WECHAT_PUBLIC_KEY_PATH=/srv/nuannuan/secrets/wechatpay_pub.pem
# WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_3000000001

# 价格仅为未来单独授权支付验收时的占位；当前免费、购买关闭，不发起真实订单。
PORTAL_MEMBER_SKU=portal_member_30d
PORTAL_MEMBER_NAME=门户网站会员
PORTAL_MEMBER_DAYS=30
PORTAL_MEMBER_PRICE_FEN=1
